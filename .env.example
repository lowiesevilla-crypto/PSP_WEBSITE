# Database
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/psp_platform"

# Application
# Local development:
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production Hostinger value must be:
# NEXT_PUBLIC_APP_URL="https://psp.hoahub.tech"
APP_ENV="development"

# Authentication (set real secrets outside source control)
# Production AUTH_SECRET must be a strong random value with at least 32 characters.
AUTH_SECRET="change-me"

# Bootstrap (temporary recovery/initialization values)
# Keep configured until a successful production /admin login is verified,
# then remove every BOOTSTRAP_ADMIN_* variable from the runtime environment.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME=""
# Optional member identity for a System Admin who is also an active PSP member.
BOOTSTRAP_ADMIN_MEMBER_NO=""
BOOTSTRAP_ADMIN_CHAPTER_CODE=""
BOOTSTRAP_ADMIN_FIRST_NAME=""
BOOTSTRAP_ADMIN_LAST_NAME=""

# Membership
MEMBERSHIP_NUMBER_PREFIX="PSP"

# PayMongo Platforms / linked accounts — server only
# Parent PSP platform account secret key and Account ID. Never expose to the browser.
PAYMONGO_PLATFORM_SECRET_KEY=""
PAYMONGO_PLATFORM_ACCOUNT_ID=""
# AES-256-GCM key material used to encrypt child org_* account IDs and webhook secrets at rest.
# Production value must be a random secret with at least 32 characters and must remain stable.
PAYMENT_CONFIG_ENCRYPTION_KEY=""
# Platform convenience fee. Basis points: 300 = 3.00%. Fixed value is in centavos.
# Either or both may be used. Payments fail closed when both are zero/unset.
PLATFORM_CONVENIENCE_FEE_BPS=""
PLATFORM_CONVENIENCE_FEE_FIXED_CENTAVOS=""
# Keep false until linked-account test-mode E2E is signed off and explicit live activation is approved.
PAYMONGO_LIVE_ENABLED="false"

# Legacy PayMongo compatibility only for pre-linked-account transactions/webhook transition.
# No new member split checkout should use these values after the linked-account release.
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
PAYMONGO_PAYMENT_METHODS="qrph"

# Certificate policy
CERTIFICATE_REQUIRE_CURRENT_DUES="false"

# Email
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
# Hostinger alias also accepted: SMTP_USERNAME
SMTP_PASSWORD=""
SMTP_FROM=""
# Hostinger alias also accepted: MAIL_FROM_ADDRESS
MAIL_FROM_NAME=""
MAIL_REPLY_TO=""
SMTP_ENCRYPTION=""

# Media / private persistent storage
# Use a persistent Hostinger application path in production.
STORAGE_ROOT="./storage"
MAX_IMAGE_UPLOAD_BYTES="5242880"
