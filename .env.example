# Database
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/psp_platform"

# Application
# Local development:
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production Hostinger value must be:
# NEXT_PUBLIC_APP_URL="https://psp.hoahub.tech"
APP_ENV="development"

# Authentication (set real secrets outside source control)
AUTH_SECRET="change-me"

# Bootstrap (temporary; remove password after first administrator is created)
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME=""

# Membership
MEMBERSHIP_NUMBER_PREFIX="PSP"

# PayMongo — server only, never expose secret key to browser
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
PAYMONGO_PAYMENT_METHODS="qrph"
PAYMONGO_PASS_ON_FEES="false"

# Certificate policy
CERTIFICATE_REQUIRE_CURRENT_DUES="false"

# Email
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Media / private persistent storage
# Use a persistent Hostinger application path in production.
STORAGE_ROOT="./storage"
MAX_IMAGE_UPLOAD_BYTES="5242880"
