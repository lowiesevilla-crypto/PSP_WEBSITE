# Database
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/psp_platform"

# Application
# Local development:
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production Hostinger value must be:
# NEXT_PUBLIC_APP_URL="https://psp.hoahub.tech"
APP_ENV="development"

# Authentication (set real secrets outside source control)
AUTH_SECRET="change-me"

# PayMongo — server only, never expose secret key to browser
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""

# Optional public PayMongo key only if required by selected integration flow
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=""

# Email
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Object storage
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
