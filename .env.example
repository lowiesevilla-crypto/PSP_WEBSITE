# Database
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/psp_platform"

# Application
# Local development:
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production Hostinger value must be:
# NEXT_PUBLIC_APP_URL="https://psp.hoahub.tech"
APP_ENV="development"

# Authentication (set a cryptographically random value of at least 32 characters)
AUTH_SECRET="change-me-with-at-least-32-random-characters"

# System Administrator bootstrap — use only during controlled initial setup,
# then remove the password from the runtime environment.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME=""

# Membership numbering. Default when blank: PSP-##########
MEMBERSHIP_NUMBER_PREFIX="PSP"

# PayMongo — server only, never expose secret key to browser
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""

# Optional public PayMongo key only if required by selected integration flow
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=""

# Email / Hostinger SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Object storage
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
