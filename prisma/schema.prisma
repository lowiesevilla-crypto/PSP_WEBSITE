generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum MembershipStatus {
  APPLICANT
  PENDING_REVIEW
  ACTIVE
  INACTIVE
  SUSPENDED
  TRANSFERRED
  RESIGNED
  DECEASED
  ARCHIVED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  CORRECTION_REQUIRED
  PENDING_REQUIREMENTS
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ChapterStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum AudienceScope {
  CHAPTER
  NATIONAL
}

enum AssessmentStatus {
  DRAFT
  ACTIVE
  CLOSED
  CANCELLED
}

enum LedgerEntryType {
  CHARGE
  PAYMENT
  ADJUSTMENT
  REFUND
  REVERSAL
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CertificateStatus {
  VALID
  REVOKED
  SUPERSEDED
  EXPIRED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapters Chapters[]
}

model Chapters {
  id           String        @id @default(cuid())
  organizationId String
  code         String        @unique
  name         String
  description  String?       @db.Text
  foundingDate DateTime?
  address      String?       @db.Text
  email        String?
  phone        String?
  logoUrl      String?
  status       ChapterStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  members      Member[]
  applications MembershipApplication[]
  roleAssignments UserRoleAssignment[]
  positions    ChapterPosition[]
  posts        Post[]
  announcements Announcement[]
  events       Event[]
  assessmentRates AssessmentRate[]
  assessments  Assessment[]
  ledgerEntries MemberLedgerEntry[]
  payments     Payment[]
  certificates Certificate[]

  @@index([organizationId, status])
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?
  displayName  String
  status       UserStatus @default(INVITED)
  emailVerifiedAt DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  member          Member?
  roleAssignments UserRoleAssignment[]
  posts           Post[]
  comments        Comment[]
  auditEvents     AuditLog[] @relation("AuditActor")
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?  @db.Text
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments UserRoleAssignment[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  chapterId String?
  startsAt  DateTime @default(now())
  endsAt    DateTime?
  createdAt DateTime @default(now())

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  chapter Chapters? @relation(fields: [chapterId], references: [id], onDelete: Restrict)

  @@index([userId, chapterId])
  @@index([roleId, chapterId])
}

model MembershipApplication {
  id          String            @id @default(cuid())
  chapterId   String
  email       String
  mobile      String?
  firstName   String
  middleName  String?
  lastName    String
  suffix      String?
  birthDate   DateTime?
  address     String?           @db.Text
  profilePhotoUrl String?
  status      ApplicationStatus @default(SUBMITTED)
  submittedAt DateTime          @default(now())
  reviewedAt  DateTime?
  reviewNotes String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  chapter Chapters @relation(fields: [chapterId], references: [id], onDelete: Restrict)

  @@index([chapterId, status])
  @@index([email])
}

model Member {
  id             String           @id @default(cuid())
  userId         String           @unique
  chapterId      String
  membershipNo   String           @unique
  firstName      String
  middleName     String?
  lastName       String
  suffix         String?
  mobile         String?
  birthDate      DateTime?
  address        String?          @db.Text
  profilePhotoUrl String?
  membershipStatus MembershipStatus @default(ACTIVE)
  joinedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  chapter        Chapters  @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  history        MembershipHistory[]
  officerAssignments OfficerAssignment[]
  ledgerEntries  MemberLedgerEntry[]
  payments       Payment[]
  certificates   Certificate[]

  @@index([chapterId, membershipStatus])
  @@index([lastName, firstName])
}

model MembershipHistory {
  id            String           @id @default(cuid())
  memberId      String
  chapterId     String
  status        MembershipStatus
  effectiveFrom DateTime
  effectiveTo   DateTime?
  reason        String?          @db.Text
  createdAt     DateTime         @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, effectiveFrom])
  @@index([chapterId])
}

model ChapterPosition {
  id          String   @id @default(cuid())
  chapterId   String
  name        String
  code        String
  level       Int      @default(0)
  parentId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapter     Chapters @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  assignments OfficerAssignment[]

  @@unique([chapterId, code])
  @@index([chapterId, level])
}

model OfficerAssignment {
  id         String   @id @default(cuid())
  memberId   String
  positionId String
  startsAt   DateTime
  endsAt     DateTime?
  createdAt  DateTime @default(now())

  member   Member          @relation(fields: [memberId], references: [id], onDelete: Restrict)
  position ChapterPosition @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@index([memberId, startsAt])
  @@index([positionId, startsAt])
}

model Post {
  id          String        @id @default(cuid())
  authorUserId String
  chapterId   String?
  audience    AudienceScope
  body        String        @db.Text
  isPinned    Boolean       @default(false)
  isHidden    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  author      User      @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  chapter     Chapters? @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  images      PostImage[]
  comments    Comment[]

  @@index([chapterId, createdAt])
  @@index([audience, createdAt])
}

model PostImage {
  id        String   @id @default(cuid())
  postId    String
  storageKey String
  url       String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Comment {
  id           String   @id @default(cuid())
  postId       String
  authorUserId String
  body         String   @db.Text
  isHidden     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([postId, createdAt])
}

model Announcement {
  id          String        @id @default(cuid())
  chapterId   String?
  audience    AudienceScope
  title       String
  body        String        @db.Text
  imageUrl    String?
  startsAt    DateTime?
  expiresAt   DateTime?
  isPinned    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  chapter Chapters? @relation(fields: [chapterId], references: [id], onDelete: Restrict)

  @@index([chapterId, startsAt])
  @@index([audience, startsAt])
}

model Event {
  id          String        @id @default(cuid())
  chapterId   String?
  audience    AudienceScope
  title       String
  description String        @db.Text
  venue       String?
  startsAt    DateTime
  endsAt      DateTime?
  imageUrl    String?
  isPublished Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  chapter Chapters? @relation(fields: [chapterId], references: [id], onDelete: Restrict)

  @@index([chapterId, startsAt])
  @@index([audience, startsAt])
}

model AssessmentType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  rates       AssessmentRate[]
  assessments Assessment[]
}

model AssessmentRate {
  id               String   @id @default(cuid())
  chapterId        String
  assessmentTypeId String
  amount           Decimal  @db.Decimal(12, 2)
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  createdAt        DateTime @default(now())

  chapter        Chapters      @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  assessmentType AssessmentType @relation(fields: [assessmentTypeId], references: [id], onDelete: Restrict)

  @@index([chapterId, assessmentTypeId, effectiveFrom])
}

model Assessment {
  id               String           @id @default(cuid())
  chapterId        String
  assessmentTypeId String
  title            String
  description      String?          @db.Text
  amount           Decimal          @db.Decimal(12, 2)
  coverageStart    DateTime?
  coverageEnd      DateTime?
  dueAt            DateTime?
  status           AssessmentStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  chapter        Chapters      @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  assessmentType AssessmentType @relation(fields: [assessmentTypeId], references: [id], onDelete: Restrict)
  ledgerEntries  MemberLedgerEntry[]
  payments       Payment[]

  @@index([chapterId, status, dueAt])
}

model MemberLedgerEntry {
  id           String          @id @default(cuid())
  chapterId    String
  memberId     String
  assessmentId String?
  paymentId    String?
  type         LedgerEntryType
  amount       Decimal         @db.Decimal(12, 2)
  reference    String?
  description  String?         @db.Text
  occurredAt   DateTime        @default(now())
  createdAt    DateTime        @default(now())

  chapter    Chapters   @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  member     Member     @relation(fields: [memberId], references: [id], onDelete: Restrict)
  assessment Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  payment    Payment?   @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([chapterId, memberId, occurredAt])
  @@index([paymentId])
}

model Payment {
  id                String        @id @default(cuid())
  chapterId         String
  memberId          String
  assessmentId      String?
  internalReference String        @unique
  gateway           String        @default("PAYMONGO")
  gatewayReference  String?       @unique
  amount             Decimal       @db.Decimal(12, 2)
  currency           String        @default("PHP")
  status             PaymentStatus @default(PENDING)
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  chapter        Chapters       @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  member         Member         @relation(fields: [memberId], references: [id], onDelete: Restrict)
  assessment     Assessment?    @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  transactions   PaymentTransaction[]
  ledgerEntries  MemberLedgerEntry[]
  receipt         Receipt?

  @@index([chapterId, status, createdAt])
  @@index([memberId, createdAt])
}

model PaymentTransaction {
  id             String   @id @default(cuid())
  paymentId      String
  gatewayEventId String?  @unique
  gatewayObjectId String?
  eventType      String?
  rawStatus      String?
  payloadHash    String?
  processedAt    DateTime?
  createdAt      DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
}

model Receipt {
  id            String   @id @default(cuid())
  paymentId     String   @unique
  receiptNumber String   @unique
  issuedAt      DateTime @default(now())
  documentUrl   String?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
}

model Certificate {
  id                String            @id @default(cuid())
  chapterId         String
  memberId          String
  certificateNumber String            @unique
  status            CertificateStatus @default(VALID)
  issuedAt          DateTime           @default(now())
  revokedAt         DateTime?
  revocationReason  String?            @db.Text
  documentUrl       String?
  verificationToken String             @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  chapter Chapters @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  member  Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@index([chapterId, status])
  @@index([memberId, issuedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  chapterId   String?
  action      String
  entityType  String
  entityId    String?
  beforeJson  Json?
  afterJson   Json?
  metadataJson Json?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([chapterId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}
